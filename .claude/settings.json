{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/edo_greet.py",
            "timeout": 20
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit|Bash|Agent|mcp__unityMCP__.*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/edo_guard.py",
            "timeout": 20,
            "statusMessage": "門番に照会"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/edo_report_lint.py",
            "timeout": 10,
            "statusMessage": "報告の作法を検める"
          }
        ]
      }
    ]
  },
  "autoCompactWindow": "300k"
}
