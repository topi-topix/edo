# ---- Unity generated (do not commit) ----
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/
[Rr]ecordings/

# Asset meta files must be committed *unless* the asset itself is ignored
!/[Aa]ssets/**/*.meta

# ---- IDE / editor project files (regenerated) ----
.vs/
.vsconfig
.idea/
.gradle/
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# ---- Unity crash / build artifacts ----
sysinfo.txt
*.stackdump
mono_crash.*.blob
mono_crash.*.json
*.apk
*.aab
*.unitypackage
*.app

# ---- Editor capture output (not project assets) ----
# Assets/ の外に置いている(1GB のスクショを Unity に import させないため)
/[Ss]creenshots/

# ---- macOS ----
.DS_Store
.AppleDouble
.LSOverride

# PLATEAU SDK tarball (799MB, do not commit)
/LocalPackages/

# ---- サードパーティ製アセットパック(再配布不可・計約7.8GB) ----
# 各自 Asset Store / BOOTH から入手して import すること。手順は README.md を参照。
/[Aa]ssets/NatureManufacture Assets/
/[Aa]ssets/NatureManufacture Assets.meta
/[Aa]ssets/Waldemarst/
/[Aa]ssets/Waldemarst.meta
/[Aa]ssets/Japanese Castle/
/[Aa]ssets/Japanese Castle.meta
/[Aa]ssets/Japanese Village Kit/
/[Aa]ssets/Japanese Village Kit.meta
# 再配布不可パッケージの**複製**を追跡しないための保険。
# edogoyomi(HONEY)の readme は "just don't sell or redistribute it" と定める。
# /Assets/edogoyomi/ は下で除外しているが、他所へコピーすると素通りする —
# 実際に Assets/Edo/Models/es_hmon/ が公開リポジトリへ入っていた(2026-08-23 に除去)。
/[Aa]ssets/**/es_hmon/
/[Aa]ssets/**/es_nmon/
/[Aa]ssets/**/es_kmon/
/[Aa]ssets/**/es_knagaya/

/[Aa]ssets/edogoyomi/
/[Aa]ssets/edogoyomi.meta
/[Aa]ssets/Japanese Shrine and Temples/
/[Aa]ssets/Japanese Shrine and Temples.meta
/[Aa]ssets/Standard Assets/
/[Aa]ssets/Standard Assets.meta

# 土地利用ベイク前のスプラット自動バックアップ(ローカル用)
/TerrainBackups/

# Python のキャッシュ(Tools/ 配下すべて)
__pycache__/
*.pyc

# 検証用スクリーンショット(ローカル用)
/Assets/Screenshots/
/Assets/Screenshots.meta
